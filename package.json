{
  "name": "noesis-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:github": "astro build --config astro.config.github.mjs",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:adblock": "astro build && node scripts/check-adblock.mjs",
    "preview:consent": "astro build && node scripts/preview-consent.mjs",
    "og-image": "node scripts/generate-og-image.mjs",
    "start": "astro build && astro preview --open"
  },
  "dependencies": {
    "astro": "^7.4.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ghostery/adblocker": "^2.20.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript-eslint": "^8.72.1"
  }
}
