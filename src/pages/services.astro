---
import Layout from '../layouts/Layout.astro';
import ServicesHero from '../components/sections/ServicesHero.astro';
import TheProblem from '../components/sections/TheProblem.astro';
import OurServices from '../components/sections/OurServices.astro';
import Verification from '../components/sections/Verification.astro';
import MeetingToSpec from '../components/sections/MeetingToSpec.astro';
import WhoIsThisFor from '../components/sections/WhoIsThisFor.astro';
import ServicesCTA from '../components/sections/ServicesCTA.astro';

const schema = {
	"@context": "https://schema.org",
	"@type": "Service",
	"name": "AI Excellence Services — Harness Engineering, Skills, Measurement",
	"description": "We help engineering teams build the right AI development harness — tools, skills, and measurement — for production-grade agentic development.",
	"provider": {
		"@type": "Organization",
		"name": "Noesis Vision"
	},
	"serviceType": "AI Engineering Consulting",
	"areaServed": "Worldwide",
	"audience": {
		"@type": "Audience",
		"audienceType": "CTOs, VP Engineering, Engineering Directors, Tech Leads"
	}
};
---

<Layout title="AI Excellence as a Service" description="We help engineering teams build the right AI development harness — tools, skills, and measurement — for production-grade agentic development." schema={schema}>
	<main class="flex flex-col gap-y-2 md:gap-y-6 overflow-hidden">
		<ServicesHero/>
		<TheProblem/>
		<OurServices/>
		<Verification/>
		<MeetingToSpec/>
		<WhoIsThisFor/>
		<ServicesCTA/>
	</main>
</Layout>
