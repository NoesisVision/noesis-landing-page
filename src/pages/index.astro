---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import Philosophy from '../components/sections/Philosophy.astro';
import WhatWeDo from '../components/sections/WhatWeDo.astro';
import Founders from '../components/sections/Founders.astro';
import HomeCTA from '../components/sections/HomeCTA.astro';

const webPageSchema = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	"name": "Coding Is Solved. Engineering IT Isn't.",
	"description": "Noesis — harness engineering, skills development, and AI measurement for production-grade agentic development.",
	"url": "https://noesis.vision",
	"speakable": {
		"@type": "SpeakableSpecification",
		"cssSelector": ["h1", ".philosophy-summary"]
	}
};
---

<Layout title="Coding Is Solved. Engineering IT Isn't." description="Noesis — harness engineering, skills development, and AI measurement for production-grade agentic development." schema={webPageSchema}>
	<main class="flex flex-col gap-y-2 md:gap-y-6 overflow-hidden">
		<HomeHero/>
		<WhatWeDo/>
		<Philosophy/>
		<Founders/>
		<HomeCTA/>
	</main>
</Layout>
