---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import Philosophy from '../components/sections/Philosophy.astro';
import TwoPillars from '../components/sections/TwoPillars.astro';
import Founders from '../components/sections/Founders.astro';
import HomeCTA from '../components/sections/HomeCTA.astro';

const webPageSchema = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	"name": "Engineer the Future of Software Delivery",
	"description": "Noesis Vision — tools and practices that make agentic development reliable, verifiable, and production-ready.",
	"url": "https://noesisvision.github.io",
	"speakable": {
		"@type": "SpeakableSpecification",
		"cssSelector": ["h1", ".philosophy-summary"]
	}
};
---

<Layout title="Engineer the Future of Software Delivery" description="Noesis Vision — tools and practices that make agentic development reliable, verifiable, and production-ready." schema={webPageSchema}>
	<main class="flex flex-col gap-y-2 md:gap-y-6 overflow-hidden">
		<HomeHero/>
		<Philosophy/>
		<TwoPillars/>
		<Founders/>
		<HomeCTA/>
	</main>
</Layout>
