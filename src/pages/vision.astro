---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import NewsletterModal from "../components/NewsletterModal.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import data from "../data/vision.json";
import ButtonRow from "../components/ui/ButtonRow.astro";
import Card from "../components/ui/Card.astro";
import CardCorner from "../components/ui/CardCorner.astro";
import CardGrid from "../components/ui/CardGrid.astro";
import CardTitle from "../components/ui/CardTitle.astro";
import Container from "../components/ui/Container.astro";
import CtaBlock from "../components/ui/CtaBlock.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Heading from "../components/ui/Heading.astro";
import Highlight from "../components/ui/Highlight.astro";
import Lead from "../components/ui/Lead.astro";
import Page from "../components/ui/Page.astro";
import PageHero from "../components/ui/PageHero.astro";
import RailDot from "../components/ui/RailDot.astro";
import Section from "../components/ui/Section.astro";
import SectionHead from "../components/ui/SectionHead.astro";
import StepNumber from "../components/ui/StepNumber.astro";
import Text from "../components/ui/Text.astro";
import WindowBar from "../components/ui/WindowBar.astro";
import ArchitectureDiagram from "../components/ArchitectureDiagram.astro";
import "../styles/pages/vision.css";
import { url } from "../config/paths.js";
import {
  DISCORD_URL,
  TALLY_BETA_URL,
  VISION_DEMO_URL,
} from "../config/integrations.js";
const { apps, faq, pillars, steps, uses, videos } = data;

// schema.org for search engines (reused from the previous noesis.vision). The FAQ entries
// are built from the FAQ shown on this page, so they always match what visitors see.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Noesis Vision",
    description:
      "Automated architecture visualization and documentation from code. Deterministic static analysis creates a shared knowledge layer for humans and AI agents.",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Cross-platform",
    url: "https://noesis.vision/vision/",
    featureList: [
      "Automated architecture visualization from code",
      "Deterministic static analysis",
      "Multi-repository support",
      "Exportable documentation (PDF, Markdown)",
      "AI agent integration via MCP",
      "Knowledge graph generation",
    ],
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      availability: "https://schema.org/PreOrder",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a.replace(/<[^>]+>/g, ""),
      },
    })),
  },
];
---

<Base
  title="Visualize. Understand. Accelerate. | Noesis Vision"
  description="Noesis Vision — automated architecture visualization and documentation from code. Deterministic static analysis for humans and AI agents."
  jsonLd={jsonLd}
>
  <Page data-ref="root">
    <Nav current="vision" />

    <main id="main">
      <PageHero>
        <div class="vision-hero-grid"></div>
        <CtaBlock>
          <Eyebrow>Noesis Vision</Eyebrow>
          <Heading as="h1" size="xl">
            Visualize. Understand. Accelerate.
          </Heading>
          <Lead width={760}>
            <Highlight>
              Visualize and auto-document your REAL architecture
            </Highlight>
            , mapping it automatically from code — so humans and AI can finally
            understand software the same way and deliver faster, with precision.
          </Lead>
          <ButtonRow snug>
            <Button
              track="cta_tally_beta"
              trackSection="vision-hero"
              variant="light"
              size="lg"
              href={TALLY_BETA_URL}
              target="_blank"
              arrow
            >
              Join Beta!
            </Button>
            <Button
              track="scroll_to_section"
              trackSection="vision-hero"
              variant="outline"
              size="lg"
              href="#demo"
              arrow
            >
              Live demo &amp; videos
            </Button>
          </ButtonRow>
        </CtaBlock>
        <div data-reveal="1" class="vision-hero-frame">
          <WindowBar>
            <div class="vision-window-title">System model · Exploration</div>
          </WindowBar>
          <div class="vision-diagram-frame">
            <div data-ref="diag" class="vision-diagram-viewport">
              <div class="vision-diagram-scaler">
                <ArchitectureDiagram />
              </div>
            </div>
          </div>
        </div>
      </PageHero>

      <Section id="how">
        <Container>
          <SectionHead data-reveal="1">
            <Heading class="vision-h2-plain">How It Works</Heading>
            <Lead class="vision-lead-640">
              Noesis automates the process of understanding system architecture
              in four simple steps
            </Lead>
          </SectionHead>
          <div class="vision-steps">
            {steps.map((s, i) => (
              <>
                <div
                  data-reveal="1"
                  class:list={[
                    "vision-step",
                    { "vision-step--first": i === 0 },
                  ]}
                >
                  <StepNumber>{s.n}</StepNumber>
                  <div class="vision-step-body">
                    <CardTitle size="lg">{s.title}</CardTitle>
                    <Text size="lg">{s.body}</Text>
                  </div>
                </div>
              </>
            ))}
          </div>
        </Container>
      </Section>

