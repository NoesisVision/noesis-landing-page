---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import "../../styles/components/ui/typography.css";

interface Props extends HTMLAttributes<"p"> {
  as?: HTMLTag;
  /** Max line length in px */
  width?: 720 | 760;
}

const { as: Tag = "p", width, class: className, ...rest } = Astro.props;
// The slot is rendered to a string so no whitespace ends up inside the element.
const html = await Astro.slots.render("default");
---

<Tag
  class:list={["lead", width && `lead-${width}`, className]}
  {...rest}
  set:html={html}
/>
