---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import "../../styles/components/ui/layout.css";

interface Props extends HTMLAttributes<"section"> {
  as?: HTMLTag;
  /** "lg" = more vertical padding, no extra bottom gap */
  size?: "md" | "lg";
}

const {
  as: Tag = "section",
  size = "md",
  class: className,
  ...rest
} = Astro.props;
// The slot is rendered to a string so no whitespace ends up inside the element.
const html = await Astro.slots.render("default");
---

<Tag
  class:list={[size === "lg" ? "section-lg" : "section", className]}
  {...rest}
  set:html={html}
/>
