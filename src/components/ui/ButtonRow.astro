---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import "../../styles/components/ui/layout.css";

interface Props extends HTMLAttributes<"div"> {
  as?: HTMLTag;
  /** Smaller gap above the row */
  snug?: boolean;
}

const {
  as: Tag = "div",
  snug = false,
  class: className,
  ...rest
} = Astro.props;
// The slot is rendered to a string so no whitespace ends up inside the element.
const html = await Astro.slots.render("default");
---

<Tag
  class:list={[snug ? "btn-row-snug" : "btn-row", className]}
  {...rest}
  set:html={html}
/>
