---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import "../../styles/components/ui/layout.css";

interface Props extends HTMLAttributes<"header"> {
  as?: HTMLTag;
}

const { as: Tag = "header", class: className, ...rest } = Astro.props;
// The slot is rendered to a string so no whitespace ends up inside the element.
const html = await Astro.slots.render("default");
---

<Tag class:list={["page-hero", className]} {...rest} set:html={html} />
