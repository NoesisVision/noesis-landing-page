---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import "../../styles/components/ui/typography.css";

interface Props extends HTMLAttributes<"p"> {
  as?: HTMLTag;
  size?: "md" | "lg";
}

const { as: Tag = "p", size = "md", class: className, ...rest } = Astro.props;
// The slot is rendered to a string so no whitespace ends up inside the element.
const html = await Astro.slots.render("default");
---

<Tag
  class:list={[size === "lg" ? "body-text-lg" : "body-text", className]}
  {...rest}
  set:html={html}
/>
