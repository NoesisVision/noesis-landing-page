---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import "../../styles/components/ui/typography.css";

interface Props extends HTMLAttributes<"strong"> {
  as?: HTMLTag;
}

const { as: Tag = "strong", class: className, ...rest } = Astro.props;
// The slot is rendered to a string so no whitespace ends up inside the element.
const html = await Astro.slots.render("default");
---

<Tag class:list={["hl", className]} {...rest} set:html={html} />
