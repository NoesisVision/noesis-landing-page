---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import BtnLink from "../shared/BtnLink.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="home" class="relative pt-24 lg:pt-36">
    <Container className="flex flex-col items-center text-center">
        <div class="absolute w-full lg:w-1/2 inset-y-0 lg:right-0">
            <span class="absolute -left-6 md:left-4 top-8 lg:top-12 w-24 h-24 rotate-90 skew-x-12 rounded-3xl bg-green-400 blur-xl opacity-60 lg:opacity-95 lg:block hidden"></span>
            <span class="absolute right-4 bottom-8 w-24 h-24 rounded-3xl bg-primary blur-xl opacity-80"></span>
        </div>
        <span class="w-4/12 lg:w-2/12 aspect-square bg-gradient-to-tr from-primary to-green-400 absolute -top-5 lg:left-0 rounded-full skew-y-12 blur-2xl opacity-40 skew-x-12 rotate-90"></span>
        <div class="relative flex flex-col items-center text-center py-1 lg:py-3 xl:py-4 max-w-3xl mx-auto px-4 sm:px-6 lg:px-0">
            <h1 class="text-4xl/tight sm:text-5xl/tight md:text-6xl/tight font-bold text-heading-1">
                <span class="text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 from-20% via-primary via-30% to-green-600">AI</span> Is Changing How You Ship. Make Sure It's an <span class="text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 from-20% via-primary via-30% to-green-600">Upgrade</span>.
            </h1>
            <Paragraph className="mt-3 lg:mt-4 text-base text-center">
                We help engineering teams build the right AI development process — from <strong>domain knowledge extraction</strong> to <strong>tools</strong>, <strong>skills</strong>, and <strong>measurement</strong> — for production-grade <strong>agentic development</strong>.
            </Paragraph>
            <div class="mt-8 lg:mt-10 flex flex-col sm:flex-row gap-4 justify-center">
                <BtnLink variant="primary" href={`${base}/services`} text="Explore Our Services" className="text-base" data-track="internal_nav" data-track-section="home-hero" />
                <BtnLink variant="secondary" href="#what-we-do" text="See Our Approach" className="text-base" data-track="scroll_to_section" data-track-section="home-hero" />
            </div>
        </div>
    </Container>
</section>
