---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
---

<section class="relative py-16 md:py-20" id="two-phase">
    <Container className="space-y-12">
        <div class="text-center max-w-4xl mx-auto space-y-4">
            <Title>
                Two-Phase Development for the AI Era
            </Title>
            <Paragraph>
                We separate creative human decisions from autonomous AI execution, with deterministic verification bridging both phases.
            </Paragraph>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
            <!-- Phase 1 -->
            <div class="p-5 sm:p-6 lg:p-8 rounded-3xl border border-box-border bg-box-bg shadow-lg shadow-box-shadow relative overflow-hidden">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center">
                        <span class="text-xl font-bold text-blue-600">1</span>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-heading-1">Collaborative Specification</h3>
                        <p class="text-sm text-primary font-medium">Humans + AI → Design Document</p>
                    </div>
                </div>

                <div class="space-y-4">
                    <div class="flex gap-3">
                        <div class="w-8 h-8 bg-blue-50 dark:bg-blue-900/20 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-blue-600">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-heading-1 font-semibold text-sm">Team workshops & domain analysis</p>
                            <p class="text-heading-3 text-xs">Stakeholders, architects, and developers align on requirements</p>
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <div class="w-8 h-8 bg-blue-50 dark:bg-blue-900/20 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-blue-600">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-heading-1 font-semibold text-sm">Precise design documents</p>
                            <p class="text-heading-3 text-xs">Specifications detailed enough for both humans and AI agents to execute</p>
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <div class="w-8 h-8 bg-blue-50 dark:bg-blue-900/20 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-blue-600">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-heading-1 font-semibold text-sm">Acceptance criteria as verification rules</p>
                            <p class="text-heading-3 text-xs">Machine-checkable criteria that become the safety net for Phase 2</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Phase 2 -->
            <div class="p-5 sm:p-6 lg:p-8 rounded-3xl border border-box-border bg-box-bg shadow-lg shadow-box-shadow relative overflow-hidden">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center">
                        <span class="text-xl font-bold text-green-600">2</span>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-heading-1">Autonomous Implementation</h3>
                        <p class="text-sm text-green-600 font-medium">AI Agents → Code + Tests + Deploy</p>
                    </div>
                </div>

                <div class="space-y-4">
                    <div class="flex gap-3">
                        <div class="w-8 h-8 bg-green-50 dark:bg-green-900/20 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-green-600">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-heading-1 font-semibold text-sm">AI agents execute from spec</p>
                            <p class="text-heading-3 text-xs">Agents autonomously implement features based on precise design documents</p>
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <div class="w-8 h-8 bg-green-50 dark:bg-green-900/20 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-green-600">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.384 3.179 1.03-5.985L2.1 7.58l6.03-.877L11.42 1.5l2.77 5.203 6.03.877-4.966 4.784 1.03 5.985-5.384-3.179z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-heading-1 font-semibold text-sm">Automated test generation</p>
                            <p class="text-heading-3 text-xs">Tests derived from acceptance criteria — not afterthought, but specification</p>
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <div class="w-8 h-8 bg-green-50 dark:bg-green-900/20 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-green-600">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-heading-1 font-semibold text-sm">Deterministic verification loop</p>
                            <p class="text-heading-3 text-xs">Every change verified against architectural rules and acceptance criteria before merge</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Handoff arrow / connection -->
        <div class="flex justify-center">
            <div class="bg-box-bg px-6 py-3 rounded-full border border-box-border text-sm font-medium text-heading-2">
                Phase 1 output = Phase 2 input — <span class="text-primary">the design document is the contract</span>
            </div>
        </div>
    </Container>
</section>