---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import BtnLink from "../shared/BtnLink.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="relative py-12 md:py-16" id="pillars">
    <Container>
        <div class="text-center max-w-4xl mx-auto space-y-4 mb-12">
            <Title>
                Two Pillars, One Vision
            </Title>
            <Paragraph>
                Reliable agentic development requires both the right tools and the right processes. We deliver both.
            </Paragraph>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
            <!-- Product Pillar -->
            <div class="p-5 sm:p-6 lg:p-8 rounded-3xl border border-box-border bg-box-bg shadow-lg shadow-box-shadow relative overflow-hidden group hover:shadow-xl transition-shadow duration-300">
                <div class="w-14 h-14 bg-blue-100 dark:bg-blue-900/30 rounded-2xl flex items-center justify-center mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-blue-600">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-heading-1 mb-3">Noesis Vision</h3>
                <p class="text-heading-3 mb-2 font-medium text-primary">Visualize. Understand. Accelerate.</p>
                <p class="text-heading-3 mb-6 text-sm leading-relaxed">
                    Automated architecture visualization and documentation, generated deterministically from code. A shared knowledge layer for humans and AI agents — precise, repeatable, and always up to date.
                </p>
                <BtnLink variant="primary" href={`${base}/vision`} text="Learn more" className="text-sm" />
            </div>

            <!-- Services Pillar -->
            <div class="p-5 sm:p-6 lg:p-8 rounded-3xl border border-box-border bg-box-bg shadow-lg shadow-box-shadow relative overflow-hidden group hover:shadow-xl transition-shadow duration-300">
                <div class="w-14 h-14 bg-green-100 dark:bg-green-900/30 rounded-2xl flex items-center justify-center mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-green-600">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12a7.5 7.5 0 0015 0m-15 0a7.5 7.5 0 1115 0m-15 0H3m16.5 0H21m-1.5 0H12m-8.457 3.077l1.41-.513m14.095-5.13l1.41-.513M5.106 17.785l1.15-.964m11.49-9.642l1.149-.964M7.501 19.795l.75-1.3m7.5-12.99l.75-1.3m-6.063 16.658l.26-1.477m2.605-14.772l.26-1.477m0 17.726l-.26-1.477M10.698 4.614l-.26-1.477M16.5 19.794l-.75-1.299M7.5 4.205L12 12m6.894 5.785l-1.149-.964M6.256 7.178l-1.15-.964m15.352 8.864l-1.41-.513M4.954 9.435l-1.41-.514M12.002 12l-3.75 6.495" />
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-heading-1 mb-3">SDLC Transformation</h3>
                <p class="text-heading-3 mb-2 font-medium text-green-600">Your SDLC, Redesigned for the AI Era</p>
                <p class="text-heading-3 mb-6 text-sm leading-relaxed">
                    From collaborative specification to autonomous implementation — with deterministic verification at every step. We redesign your development lifecycle for reliable human-AI collaboration.
                </p>
                <BtnLink variant="primary" href={`${base}/services`} text="Learn more" className="text-sm" />
            </div>
        </div>
    </Container>
</section>
