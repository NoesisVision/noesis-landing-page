---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import Button from "../shared/Button.astro";
import BtnLink from "../shared/BtnLink.astro";

export interface Props {
    className?: string;
}

const { className } = Astro.props;
---

<section class="relative py-16 md:py-20" id="savings">
    <Container className={`space-y-6 md:space-y-8 ${className}`}>
        <div class="text-center max-w-5xl mx-auto space-y-4">
            <Title>
                Real Savings, Real Results
            </Title>
            <Paragraph>
                Stop wasting time and money on manual documentation. Noesis delivers comprehensive system knowledge at a fraction of the cost and time of traditional approaches.
            </Paragraph>
        </div>
        
        <div class="grid lg:grid-cols-2 gap-12">
            <!-- Traditional Approach -->
            <div class="bg-red-50 dark:bg-red-900/20 p-8 rounded-xl border-2 border-red-200 dark:border-red-800">
                    <div class="text-center mb-6">
                        <div class="w-16 h-16 bg-red-100 dark:bg-red-900 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-red-600">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                            </svg>
                        </div>
                        <h3 class="text-2xl font-bold text-red-600">Traditional Manual Approach</h3>
                    </div>
                    
                    <div class="space-y-6">
                        <div class="bg-box-bg p-6 rounded-lg border border-box-border">
                            <h4 class="font-semibold mb-3 text-heading-1">Time Investment</h4>
                            <div class="space-y-2 text-sm text-heading-3">
                                <div class="flex justify-between">
                                    <span>Initial documentation setup</span>
                                    <span class="font-semibold">40-80 hours</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>Monthly maintenance</span>
                                    <span class="font-semibold">20-40 hours</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>Annual updates (system review & major updates)</span>
                                    <span class="font-semibold">60-120 hours</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="bg-box-bg p-6 rounded-lg border border-box-border">
                            <h4 class="font-semibold mb-3 text-heading-1">Cost Breakdown</h4>
                            <div class="space-y-2 text-sm text-heading-3">
                                <div class="flex justify-between">
                                    <span>Initial setup (40-80 hours @ €80/hour)</span>
                                    <span class="font-semibold">€3,200-6,400</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>Monthly maintenance (20-40h × 12 @ €80/hour)</span>
                                    <span class="font-semibold">€19,200-38,400</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>Annual updates (60-120 hours @ €80/hour)</span>
                                    <span class="font-semibold">€4,800-9,600</span>
                                </div>
                                <div class="flex justify-between border-t pt-2">
                                    <span class="font-semibold">Total annual cost</span>
                                    <span class="font-bold text-red-600">€27,200-54,400</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="bg-red-100 dark:bg-red-900/30 p-4 rounded-lg">
                            <h4 class="font-semibold mb-2 text-red-800 dark:text-red-200">Pain Points</h4>
                            <ul class="text-sm text-red-700 dark:text-red-300 space-y-1">
                                <li>• Documentation quickly becomes outdated</li>
                                <li>• High risk of human error</li>
                                <li>• Difficult to maintain consistency</li>
                                <li>• Time-consuming manual updates</li>
                            </ul>
                        </div>
                    </div>
                </div>
                
                <!-- Noesis Approach -->
                <div class="bg-green-50 dark:bg-green-900/20 p-8 rounded-xl border-2 border-green-200 dark:border-green-800">
                    <div class="text-center mb-6">
                        <div class="w-16 h-16 bg-green-100 dark:bg-green-900 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-green-600">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3 class="text-2xl font-bold text-green-600">Noesis Automated Solution</h3>
                    </div>
                    
                    <div class="space-y-6">
                        <div class="bg-box-bg p-6 rounded-lg border border-box-border">
                            <h4 class="font-semibold mb-3 text-heading-1">Time Investment</h4>
                            <div class="space-y-2 text-sm text-heading-3">
                                <div class="flex justify-between">
                                    <span>Initial setup</span>
                                    <span class="font-semibold">2-4 hours</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>Monthly maintenance</span>
                                    <span class="font-semibold">0-2 hours</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>Automatic updates</span>
                                    <span class="font-semibold">0 hours</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="bg-box-bg p-6 rounded-lg border border-box-border">
                            <h4 class="font-semibold mb-3 text-heading-1">Cost Breakdown (for 300k LOC repository)</h4>
                            <div class="space-y-2 text-sm text-heading-3">
                                <div class="flex justify-between">
                                    <span>Noesis subscription (€200/month × 12)</span>
                                    <span class="font-semibold">€2,400</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>LLM initial analysis (€10/100k LOC × 3)</span>
                                    <span class="font-semibold">€30</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>LLM monthly updates (€1/100k LOC × 3 × 12)</span>
                                    <span class="font-semibold">€36</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>Setup time (2-4 hours × €80)</span>
                                    <span class="font-semibold">€160-320</span>
                                </div>
                                <div class="flex justify-between border-t pt-2">
                                    <span class="font-semibold">Total annual cost</span>
                                    <span class="font-bold text-green-600">€2,626-2,786</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="bg-green-100 dark:bg-green-900/30 p-4 rounded-lg">
                            <h4 class="font-semibold mb-2 text-green-800 dark:text-green-200">Benefits</h4>
                            <ul class="text-sm text-green-700 dark:text-green-300 space-y-1">
                                <li>• Always up-to-date documentation</li>
                                <li>• Zero human error in analysis</li>
                                <li>• Consistent, structured output</li>
                                <li>• Instant updates with code changes</li>
                                <li>• Hosted by clients - no infrastructure costs</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Savings Summary -->
            <div class="mt-12 bg-box-bg p-8 rounded-xl border border-box-border">
                <h3 class="text-2xl font-bold mb-6 text-center text-heading-1">Your Annual Savings</h3>
                <div class="grid md:grid-cols-3 gap-8">
                    <div class="text-center">
                        <div class="text-4xl font-bold text-blue-600 mb-2">€24,414-51,614</div>
                        <div class="text-heading-3">Direct cost savings</div>
                    </div>
                    <div class="text-center">
                        <div class="text-4xl font-bold text-green-600 mb-2">218-438</div>
                        <div class="text-heading-3">Hours saved annually</div>
                    </div>
                    <div class="text-center">
                        <div class="text-4xl font-bold text-purple-600 mb-2">90-95%</div>
                        <div class="text-heading-3">Cost reduction</div>
                    </div>
                </div>
                
                <div class="mt-8 text-center">
                    <p class="text-lg text-heading-3 mb-6">
                        <strong>ROI: 900-2000%</strong> - Your investment pays for itself in just 1-2 months
                    </p>
                </div>
            </div>
            
            <!-- Research Sources & Methodology -->
            <div class="mt-8 bg-gray-50 dark:bg-gray-800/50 p-6 rounded-xl">
                <h4 class="font-semibold mb-4 text-heading-1">Research Sources & Methodology</h4>
                <div class="grid md:grid-cols-2 gap-4 text-sm text-heading-3">
                    <div>
                        <p class="font-medium mb-2">Documentation Costs & Developer Rates:</p>
                        <ul class="space-y-1 text-xs">
                            <li>• <a href="https://about.gitlab.com/developer-survey/" target="_blank" class="text-blue-600 hover:underline">GitLab State of DevOps Report 2024</a>: "5,000+ DevSecOps professionals surveyed"</li>
                            <li>• <a href="https://survey.stackoverflow.co/2024/" target="_blank" class="text-blue-600 hover:underline">Stack Overflow Developer Survey 2024</a>: "65,437 developers from 185 countries"</li>
                            <li>• <a href="https://octoverse.github.com/" target="_blank" class="text-blue-600 hover:underline">GitHub State of the Octoverse 2024</a>: "Developer productivity and tool adoption trends"</li>
                            <li>• <strong>Senior C# Developer rates:</strong> €80-100/hour in Europe (2024)</li>
                        </ul>
                    </div>
                    <div>
                        <p class="font-medium mb-2">ROI & Savings Analysis:</p>
                        <ul class="space-y-1 text-xs">
                            <li>• <a href="https://www.jetbrains.com/lp/devecosystem-2024/" target="_blank" class="text-blue-600 hover:underline">JetBrains State of Developer Ecosystem 2024</a>: "Developer tool adoption and productivity"</li>
                            <li>• <a href="https://slashdata.co/reports/" target="_blank" class="text-blue-600 hover:underline">SlashData Developer Economics 2024</a>: "Developer productivity and compensation analysis"</li>
                            <li>• <a href="https://www.microsoft.com/en-us/research/" target="_blank" class="text-blue-600 hover:underline">Microsoft Research 2024</a>: "Software maintenance and documentation costs"</li>
                            <li>• <strong>Calculation basis:</strong> 300k LOC repository, client-hosted infrastructure</li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <!-- Pricing Tiers -->
            <div class="mt-16" id="pricing">
                <h3 class="text-3xl font-bold mb-4 text-center text-heading-1">Simple, Transparent Pricing</h3>
                <p class="text-center text-heading-3 mb-12 max-w-2xl mx-auto">Pricing based on your codebase size. No hidden fees, no surprises.</p>
                
                <div class="grid lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
                    <!-- Starter Plan -->
                    <div class="bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-800 dark:to-gray-900 p-8 rounded-2xl border border-gray-200 dark:border-gray-700 relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-blue-100 to-blue-200 dark:from-blue-900/20 dark:to-blue-800/20 rounded-full -translate-y-16 translate-x-16"></div>
                        
                        <div class="relative z-10">
                            <div class="text-sm font-semibold text-blue-600 dark:text-blue-400 mb-2">STARTER</div>
                            <div class="text-4xl font-bold text-heading-1 mb-2">€20</div>
                            <div class="text-heading-3 mb-6">per month</div>
                            
                            <div class="space-y-4 mb-8">
                                <div class="flex items-center text-heading-2">
                                    <div class="w-2 h-2 bg-blue-500 rounded-full mr-3"></div>
                                    <span class="font-medium">Up to 20k lines of code</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Professional Plan -->
                    <div class="bg-gradient-to-br from-primary/5 to-primary/10 dark:from-primary/10 dark:to-primary/20 p-8 rounded-2xl border-2 border-primary relative overflow-hidden transform scale-105">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-primary/20 to-primary/30 rounded-full -translate-y-16 translate-x-16"></div>
                        
                        <div class="relative z-10">
                            <div class="text-sm font-semibold text-primary mb-2">PROFESSIONAL</div>
                            <div class="text-4xl font-bold text-heading-1 mb-2">€200</div>
                            <div class="text-heading-3 mb-1">per 100k LOC/month*</div>
                            <div class="text-sm text-heading-3 mb-6">or €2,000/year*</div>
                            
                            <div class="space-y-4 mb-8">
                                <div class="flex items-center text-heading-2">
                                    <div class="w-2 h-2 bg-primary rounded-full mr-3"></div>
                                    <span class="font-medium">100k - 1M lines of code</span>
                                </div>
                            </div>
                            
                            <div class="text-xs text-heading-3 mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                                * Limits for the code repos assignments apply
                            </div>
                            
                            <div class="text-center mt-6">
                                <span class="bg-gradient-to-r from-primary to-blue-600 text-white px-3 py-1 rounded-lg text-xs font-semibold border border-primary/20 shadow-sm">★ RECOMMENDED</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Enterprise Plan -->
                    <div class="bg-gradient-to-br from-purple-50 to-purple-100 dark:from-purple-900/20 dark:to-purple-800/20 p-8 rounded-2xl border border-purple-200 dark:border-purple-700 relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-purple-100 to-purple-200 dark:from-purple-900/20 dark:to-purple-800/20 rounded-full -translate-y-16 translate-x-16"></div>
                        
                        <div class="relative z-10">
                            <div class="text-sm font-semibold text-purple-600 dark:text-purple-400 mb-2">ENTERPRISE</div>
                            <div class="text-4xl font-bold text-heading-1 mb-2">Custom</div>
                            <div class="text-heading-3 mb-6">pricing</div>
                            
                            <div class="space-y-4 mb-8">
                                <div class="flex items-center text-heading-2">
                                    <div class="w-2 h-2 bg-purple-500 rounded-full mr-3"></div>
                                    <span class="font-medium">1M+ lines of code</span>
                                </div>
                                <div class="flex items-center text-heading-2">
                                    <div class="w-2 h-2 bg-purple-500 rounded-full mr-3"></div>
                                    <span class="font-medium">Corporate SSO integration</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="mt-12 text-center">
                    <BtnLink variant="primary" href="https://calendly.com/szymon-noesis/30min" text="Book a Demo" target="_blank" />
                </div>
            </div>
        </div>
    </Container>
</section>
