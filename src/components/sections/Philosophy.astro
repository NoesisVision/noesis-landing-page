---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import BtnLink from "../shared/BtnLink.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="relative py-10 md:py-14" id="why-us">
    <Container className="space-y-8">
        <div class="text-center max-w-4xl mx-auto space-y-4">
            <Title>
                AI Needs an Architect, Not Just an API Key
            </Title>
            <Paragraph>
                An experienced engineer who understands <strong>architecture, domain modeling, and team dynamics</strong> — equipped with deep AI knowledge — should be the one co-creating the AI harness for your project. That's exactly who we are.
            </Paragraph>
        </div>

        <!-- Stats grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
            <div class="text-center p-4">
                <div class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 via-primary to-green-600 mb-2">
                    2,000+
                </div>
                <p class="text-heading-3 text-sm font-medium">Engineers & architects trained</p>
            </div>
            <div class="text-center p-4">
                <div class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 via-primary to-green-600 mb-2">
                    20+
                </div>
                <p class="text-heading-3 text-sm font-medium">Consulting projects delivered</p>
            </div>
            <div class="text-center p-4">
                <div class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 via-primary to-green-600 mb-2">
                    10+ yrs
                </div>
                <p class="text-heading-3 text-sm font-medium">Of hands-on architecture practice</p>
            </div>
            <div class="text-center p-4">
                <div class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 via-primary to-green-600 mb-2">
                    Now
                </div>
                <p class="text-heading-3 text-sm font-medium">Applying that expertise to AI engineering</p>
            </div>
        </div>

        <!-- CTA -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <BtnLink variant="primary" href="https://tally.so/r/vGEdvl" text="Request Contact" target="_blank" className="text-base" data-track="cta_contact_form" data-track-section="philosophy" />
            <BtnLink variant="secondary" href={`${base}/services`} text="See Our Services" className="text-base" data-track="internal_nav" data-track-section="philosophy" />
        </div>

        <!-- Key message -->
        <div class="max-w-3xl mx-auto text-center">
            <p class="text-heading-3 text-sm leading-relaxed italic">
                We believe the fusion of deep architectural expertise, domain modeling that extracts real business knowledge, and years of teaching engineers how to think in systems — is a uniquely powerful foundation for designing AI development processes that actually deliver.
            </p>
        </div>
    </Container>
</section>
