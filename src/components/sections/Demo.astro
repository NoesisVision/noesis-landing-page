---
import Button from "../shared/Button.astro";

// Import videos
import demoVideoMp4 from "../../../public/videos/websummit-demo-short-2.mp4";
import codeClarityVideo from "../../../public/videos/code-clarity-ep1-with covers.mp4";

---

<section id="demo" class="w-full bg-body pt-0 lg:pt-4 pb-16 lg:pb-20">
  <div class="mx-auto max-w-7xl w-full px-5 sm:px-8 md:px-14 lg:px-5">
    <div class="w-full mx-auto flex flex-col items-center gap-16">

      <!-- CTA Section -->
      <div class="w-full flex flex-col items-center gap-6">
        <div class="text-center px-4">
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-heading-1 dark:text-white mb-3">
            See Noesis Vision in Action
          </h2>
          <p class="text-lg text-heading-3 dark:text-gray-300 max-w-2xl mx-auto">
            Experience the clarity of well-structured, visual code insights and join our beta program!
          </p>
        </div>

        <div class="flex flex-col sm:flex-row justify-center items-center gap-8">
          <Button variant="primary" onclick="window.open('http://98.86.2.2:5000', '_blank')" data-track="cta_demo" data-track-section="demo">
            <span class="font-bold text-lg px-4">🚀 Try Live Demo Now</span>
          </Button>
          <Button variant="secondary" onclick="window.open('https://tally.so/r/wMWrqY', '_blank')" data-track="cta_tally_beta" data-track-section="demo">
            <span class="font-semibold text-lg px-4">Join Beta Program</span>
          </Button>
        </div>
      </div>

      <video
        class="w-full max-w-4xl h-auto rounded-lg shadow-2xl shadow-gray-400/50 dark:shadow-gray-900/50 cursor-pointer"
        loop
        muted
        playsinline
        controls
        preload="metadata"
      >
        <source src={demoVideoMp4} type="video/mp4">
        Your browser doesn't support playing video.
      </video>

      <video
        class="w-full max-w-4xl h-auto rounded-lg shadow-2xl shadow-gray-400/50 dark:shadow-gray-900/50 cursor-pointer"
        loop
        muted
        playsinline
        controls
        preload="metadata"
      >
        <source src={codeClarityVideo} type="video/mp4">
          Your browser doesn't support playing video.
      </video>
    </div>
  </div>
</section> 