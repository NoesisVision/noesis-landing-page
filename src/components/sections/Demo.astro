---
import Button from "../shared/Button.astro";

// Import videos
import demoVideoWebm from "../../../public/videos/noesis-demo-optimized.webm";
import demoVideoMp4 from "../../../public/videos/noesis-demo-optimized.mp4";
import codeClarityVideo from "../../../public/videos/code-clarity-ep1-with covers.mp4";

---

<section id="demo" class="w-full py-4 bg-body pt-12 lg:pt-16 pb-16 lg:pb-20">
  <div class="mx-auto max-w-7xl w-full px-5 sm:px-8 md:px-14 lg:px-5">
    <div class="w-full max-w-[1920px] mx-auto flex flex-col items-center gap-8">
      <video
        class="w-full h-auto rounded-lg shadow-2xl shadow-gray-400/50 dark:shadow-gray-900/50 cursor-pointer"
        loop
        muted
        playsinline
        controls
        preload="metadata"
      >
        <source src={demoVideoWebm} type="video/webm">
        <source src={demoVideoMp4} type="video/mp4">
        Twoja przeglądarka nie wspiera odtwarzania wideo.
      </video>
      
      <video
        class="w-full h-auto rounded-lg shadow-2xl shadow-gray-400/50 dark:shadow-gray-900/50 cursor-pointer"
        loop
        muted
        playsinline
        controls
        preload="metadata"
      >
        <source src={codeClarityVideo} type="video/mp4">
        Twoja przeglądarka nie wspiera odtwarzania wideo.
      </video>
      
      <div class="flex justify-center mt-4">
          <Button variant="primary" onclick="window.open('https://tally.so/r/wMWrqY', '_blank')">
              <span class="font-bold text-lg">Join beta!</span>
          </Button>
      </div>
    </div>
  </div>
</section> 