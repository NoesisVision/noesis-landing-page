---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import BtnLink from "../shared/BtnLink.astro";
---

<section id="services-home" class="relative pt-24 lg:pt-36">
    <Container className="flex flex-col items-center text-center">
        <div class="absolute w-full lg:w-1/2 inset-y-0 lg:right-0">
            <span class="absolute -left-6 md:left-4 top-8 lg:top-12 w-24 h-24 rotate-90 skew-x-12 rounded-3xl bg-green-400 blur-xl opacity-60 lg:opacity-95 lg:block hidden"></span>
            <span class="absolute right-4 bottom-8 w-24 h-24 rounded-3xl bg-primary blur-xl opacity-80"></span>
        </div>
        <span class="w-4/12 lg:w-2/12 aspect-square bg-gradient-to-tr from-primary to-green-400 absolute -top-5 lg:left-0 rounded-full skew-y-12 blur-2xl opacity-40 skew-x-12 rotate-90"></span>
        <div class="relative flex flex-col items-center text-center py-1 lg:py-3 xl:py-4 max-w-3xl mx-auto px-4 sm:px-6 lg:px-0">
            <h1 class="text-4xl/tight sm:text-5xl/tight md:text-6xl/tight font-bold text-heading-1">
                <span class="text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 from-20% via-primary via-30% to-green-600">AI Excellence</span> as a <span class="text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 from-20% via-primary via-30% to-green-600">Service</span>
            </h1>
            <Paragraph className="mt-3 lg:mt-4 text-base text-center">
                We help engineering teams design the right <strong>development process</strong> for AI — from <strong>domain knowledge extraction</strong> through <strong>harness engineering</strong> to <strong>skills</strong> and <strong>measurement</strong>. Our domain modelers know how to organize the flow of business knowledge in an AI-driven world.
            </Paragraph>
            <div class="mt-8 lg:mt-10 flex flex-col sm:flex-row gap-4 justify-center">
                <BtnLink variant="primary" href="https://tally.so/r/vGEdvl" text="Request Contact" className="text-base" target="_blank" data-track="cta_contact_form" data-track-section="services-hero" />
                <BtnLink variant="secondary" href="#our-services" text="See how we help" className="text-base" data-track="scroll_to_section" data-track-section="services-hero" />
            </div>
        </div>
    </Container>
</section>