---
import GroupFooterNav from "../blocks/GroupFooterNav.astro";
import Container from "../shared/Container.astro";
import FooterNav from "../shared/FooterNav.astro";
import Paragraph from "../shared/Paragraph.astro";
// Import logo
import noesisLogo from "../../../public/logos/noesis.webp";

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const footerResources = [
    {
        itemText:"Documentation",
        itemLink:"https://noesisvision.github.io/noesis-docs"
    },
    {
        itemText:"GitHub",
        itemLink:"https://github.com/NoesisVision"
    }
]

const footerPages = [
    {
        itemText:"Services",
        itemLink:`${base}/services`
    },
    {
        itemText:"NASDE",
        itemLink:`${base}/nasde`
    },
    {
        itemText:"Vision",
        itemLink:`${base}/vision`
    }
]

const footerSocial = [
    {
        itemText:"Blog",
        itemLink:"https://noesisvision.substack.com/"
    },
    {
        itemText:"YouTube",
        itemLink:"https://www.youtube.com/@noesis.vision"
    },
    {
        itemText:"LinkedIn",
        itemLink:"https://www.linkedin.com/company/noesis-vision"
    }
]

---
<div class="mt-16"></div>
<footer class="relative  bg-gradient-to-tr from-gray-100 to-gray-200 dark:from-gray-900 dark:to-transparent pt-12 rounded-t-3xl">
    <div class="absolute right-0 top-0 h-full w-full flex justify-end">
        <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
            <span
              class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
            ></span>
          </div>
      </div>

      <div class="absolute left-0 bottom-0 h-full w-full flex items-end">
        <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
            <span
              class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
            ></span>
          </div>
      </div>
    <!-- Main Footer Content -->
    <Container className="pb-6 relative">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-8">
            <!-- Logo -->
            <div class="flex justify-center md:justify-start">
                <a href={`${base}/`} class="relative flex items-center gap-3">
                    <img src={noesisLogo.src} alt="Noesis logo" class="w-8 h-8"/>
                    <div class="inline-flex text-lg font-semibold text-heading-1">
                        Noesis
                    </div>
                </a>
            </div>

            <!-- Pages -->
            <div>
                <FooterNav title="Pages" navItems={footerPages}/>
            </div>

            <!-- Resources -->
            <div>
                <FooterNav title="Resources" navItems={footerResources}/>
            </div>

            <!-- Social Media -->
            <div>
                <FooterNav title="Social Media" navItems={footerSocial}/>
            </div>

            <!-- Company Address -->
            <div>
                <h2 class="capitalize font-semibold text-heading-1 text-xl mb-6">Contact</h2>
                <div class="space-y-3 font-medium md:text-lg text-heading-3">
                    <div class="font-medium text-heading-1">Noesis Vision Sp. z o.o.</div>
                    <div>ul. Żelazna 51/53</div>
                    <div>00-841 Warsaw - Poland</div>
                </div>
            </div>
        </div>
    </Container>

    <div class=" bg-gradient-to-tl from-box-bg py-2 relative">
        <Container>
            <div class="flex justify-between items-center gap-6 text-lg text-heading-3">
                <div>
                    &copy; <span id="year"></span> Noesis Vision Sp. z o.o. All right reserved
                </div>
                <!--<div>-->
                <!--    Proudly made by <a href="https://github.com/johnkat-mj" target="_blank" class="font-semibold">John Kat</a>-->
                <!--</div>-->
            </div>
        </Container>
    </div>
</footer>
