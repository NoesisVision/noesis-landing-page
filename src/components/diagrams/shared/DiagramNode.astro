---
export interface Props {
  x: number;
  y: number;
  width?: number;
  height?: number;
  label: string;
  sublabel?: string;
  color?: string;
  dataAnimate?: string;
}
const { x, y, width = 180, height = 60, label, sublabel, color = "rgb(var(--heading-1))", dataAnimate } = Astro.props;
---
<g data-animate={dataAnimate} transform={`translate(${x}, ${y})`}>
  <rect
    x="0" y="0"
    width={width} height={height}
    rx="12" ry="12"
    class="fill-box-bg"
    stroke={color}
    stroke-width="1.5"
  />
  <text
    x={width/2} y={sublabel ? height/2 - 6 : height/2 + 1}
    text-anchor="middle"
    dominant-baseline="middle"
    class="fill-heading-1"
    style="font-family: Raleway, sans-serif; font-size: 13px; font-weight: 600;"
  >{label}</text>
  {sublabel && (
    <text
      x={width/2} y={height/2 + 12}
      text-anchor="middle"
      dominant-baseline="middle"
      class="fill-heading-3"
      style="font-family: Raleway, sans-serif; font-size: 11px;"
    >{sublabel}</text>
  )}
</g>
